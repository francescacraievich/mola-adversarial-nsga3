+// ---------------------------------------------------------------------------
+// LidarOdometry
+// ---------------------------------------------------------------------------
+bool LidarOdometry::fullStateEnabled() { return config().attivo; }
+
+std::string LidarOdometry::fullStateSerialize(
+  const std::optional<mrpt::Clock::time_point> & stamp, std::array<uint64_t, 3> * impronte)
+{
+  // Caller holds state_mtx_. Other mutexes are taken one at a time, always
+  // after state_mtx_, as in the rest of the module.
+  Scrittore w;
+  w.grezzo(MAGIC, sizeof(MAGIC));
+  w.pod<uint32_t>(VERSIONE);
+  w.u8(stamp.has_value());
+  w.pod<int64_t>(stamp ? tick(*stamp) : 0);
+  const std::size_t inizioCorpo = w.buf.size();
+
+  // 1: MethodState fields
+  sezione(w, 1);
+  richiedi(!state_.external_georef.has_value(), "external_georef presente");
+  richiedi(state_.sync_obs.empty(), "sync_obs non vuoto (piu' LiDAR)");
+  richiedi(state_.last_gnss_.empty(), "osservazioni GNSS presenti");
+
+  w.u8(state_.initial_localization_done);
+  w.u8(state_.gravity_calib_pitch_roll.has_value());
+  if (state_.gravity_calib_pitch_roll) {
+    w.f64(state_.gravity_calib_pitch_roll->first);
+    w.f64(state_.gravity_calib_pitch_roll->second);
+  }
+  w.f64Opt(state_.gravity_calib_first_available_time);
+  w.u8(state_.gravity_calib_pose.has_value());
+  if (state_.gravity_calib_pose) w.posa(*state_.gravity_calib_pose);
+
+  w.posaPdf(state_.last_lidar_pose);
+  w.u64(state_.last_obs_tim_by_label.size());
+  for (const auto & [k, t] : state_.last_obs_tim_by_label) {
+    w.stringa(k);
+    w.tempo(t);
+  }
+  w.u64(state_.last_lidar_sensor_poses.size());
+  for (const auto & [k, p] : state_.last_lidar_sensor_poses) {
+    w.stringa(k);
+    w.posa(p);
+  }
+  w.u8(state_.last_icp_was_good);
+  w.f64(state_.last_icp_quality);
+  w.u64(state_.last_icp_iterations);
+  w.tempoOpt(state_.first_ever_timestamp);
+  w.tempoOpt(state_.last_obs_timestamp);
+  w.tempoOpt(state_.last_icp_timestamp);
+  w.f64(state_.last_observed_scan_period_sec);
+
+  w.u8(state_.last_motion_model_output.has_value());
+  if (state_.last_motion_model_output) {
+    w.posaPdfInf(state_.last_motion_model_output->pose);
+    w.twist(state_.last_motion_model_output->twist);
+    w.matrice(state_.last_motion_model_output->twist_inv_cov);
+  }
+
+  w.f64(state_.adapt_thres_sigma);
+  w.pod<int32_t>(state_.consecutive_bad_icps);
+  w.u64(state_.registrations_attempted);
+  w.u64(state_.registration_no_motion_model);
+  w.u64(state_.registration_icp_rejected);
+  w.f64Opt(state_.estimated_observation_radius);
+  w.f64Opt(state_.instantaneous_observation_radius);
+  w.u8(state_.map_has_been_loaded);
+
+  w.pod<uint32_t>(state_.localmap_check_removal_counter);
+  w.pod<uint32_t>(state_.localmap_advertise_updates_counter);
+  w.u8(state_.local_map_needs_viz_update);
+  w.u8(state_.local_map_needs_publish);
+  w.u8(state_.local_map_georef_needs_publish);
+  w.f64Opt(state_.last_yaw_for_viz_camera);
+  w.pod<uint32_t>(state_.step_counter_post_relocalization);
+  w.pod<uint32_t>(state_.mapUpdateCnt);
+
+  w.u64(state_.recent_lidar_stamps.size());
+  for (const auto & [k, b] : state_.recent_lidar_stamps) {
+    w.stringa(k);
+    bufferCircolareScrivi(w, b);
+  }
+  bufferCircolareScrivi(w, state_.recent_gnss_stamps);
+
+  // 2: keyframe decider
+  sezione(w, 2);
+  for (const auto * d : {&state_.kf_decider_local_map, &state_.kf_decider_simplemap}) {
+    w.u8(d->has_value());
+    if (d->has_value()) {
+      std::string s;
+      (*d)->saveFullState(s);
+      w.stringa(s);
+    }
+  }
+
+  // 3: state guarded by imu_state_mtx_
+  sezione(w, 3);
+  {
+    auto lckImu = mrpt::lockHelper(imu_state_mtx_);
+    richiedi(!state_.imu_initializer.has_value(), "imu_initializer presente");
+    richiedi(state_.gravity_estimator.acc_buffer.size() == 0, "buffer dell'accelerometro non vuoto");
+    richiedi(pending_imu_.size() == 0, "IMU in attesa");
+#if defined(MOLA_LO_HAS_MAP_GRAVITY_ESTIMATOR)
+    {
+      const auto & mg = state_.map_gravity;
+      richiedi(
+        !mg.last_imu_time && !mg.open_t_from && mg.intervals_since_solve == 0 &&
+          !mg.pending_relevel && !mg.relevel_decided && !mg.applied_relevel,
+        "stima della gravita' nella mappa avviata");
+    }
+#endif
+    w.posa(state_.gravity_estimator.imu_sensor_pose);
+    w.f64(state_.gravity_estimator.imu_sensor_pose_timestamp);
+    w.f64(pending_imu_.*get(PibConsumed{}));
+    bufferCircolareScrivi(w, state_.recent_imu_stamps);
+
+    const auto vars = state_.parameter_source.getVariableValues();
+    w.u64(vars.size());
+    for (const auto & [k, v] : vars) {
+      w.stringa(k);
+      w.f64(v);
+    }
+    const auto & lvb = state_.parameter_source.localVelocityBuffer;
+    w.f64(lvb.parameters.max_time_window);
+    w.f64(lvb.*get(LvbRefTime{}));
+    vettori3Scrivi(w, lvb.*get(LvbLinVel{}));
+    vettori3Scrivi(w, lvb.*get(LvbAngVel{}));
+    vettori3Scrivi(w, lvb.*get(LvbLinAcc{}));
+    const auto & orient = lvb.*get(LvbOrient{});
+    w.u64(orient.size());
+    for (const auto & [t, R] : orient) {
+      w.f64(t);
+      w.matrice(R);
+    }
+  }
+
+  // 4: LidarOdometry members outside MethodState, and params_ changed at run time
+  sezione(w, 4);
+  {
+    auto lckWait = mrpt::lockHelper(worker_lidar_wait_for_imu_list_mtx_);
+    richiedi(worker_lidar_wait_for_imu_list_.size() == 0, "scan in attesa di IMU");
+    w.f64(last_lidar_arrival_stamp_);
+  }
+  w.f64(latest_imu_time_.load());
+  w.f64(latest_obs_time_.load());
+  w.f64(lidar_scan_period_.load());
+  w.u64(params_.optimize_twist_max_corrections);
+  {
+    auto lckDrop = mrpt::lockHelper(drop_stats_mtx_);
+    for (std::size_t i = 0; i < MethodState::DROP_STATS_WINDOW_LENGTH; i++) {
+      w.u8(state_.drop_frames_stats_good[i]);
+      w.u8(state_.drop_frames_stats_dropped[i]);
+    }
+    w.u64(state_.drop_frames_stats_next_index);
+  }
+
+  // 5: estimated trajectory (TPose3D, six doubles per pose)
+  sezione(w, 5);
+  {
+    auto lckTraj = mrpt::lockHelper(state_trajectory_mtx_);
+    w.u64(state_.estimated_trajectory.size());
+    for (const auto & [t, p] : state_.estimated_trajectory) {
+      w.tempo(t);
+      w.tposa(p);
+    }
+  }
+
+  // 6: simplemap (MRPT serialization; not used by the odometry)
+  sezione(w, 6);
+  {
+    auto lckSm = mrpt::lockHelper(state_simplemap_mtx_);
+    const auto & sm = state_.reconstructed_simplemap;
+    w.stringa(serializzaMrpt(sm));
+    // Unload queue (memory only): pointers to the same SensoryFrames as the
+    // simplemap, saved as indices into the simplemap.
+    w.u64(state_.past_simplemaps_observations.size());
+    for (const auto & [t, sf] : state_.past_simplemaps_observations) {
+      std::size_t idx = sm.size();
+      for (std::size_t i = 0; i < sm.size(); i++) {
+        if (sm.get(i).sf == sf) {
+          idx = i;
+          break;
+        }
+      }
+      richiedi(idx < sm.size(), "osservazione da scaricare fuori dal simplemap");
+      w.tempo(t);
+      w.u64(idx);
+    }
+  }
+  const std::size_t fineLo = w.buf.size();
+
+  // 7: local map, MRPT serialization plus exact keyframe poses
+  sezione(w, 7);
+  {
+    auto lckMap = mrpt::lockHelper(local_map_content_mtx_);
+    ASSERT_(state_.local_map);
+    w.stringa(serializzaMrpt(*state_.local_map));
+
+    std::vector<std::pair<std::string, const KeyframePointCloudMap *>> kfms;
+    for (const auto & [nome, ly] : state_.local_map->layers) {
+      if (ly && std::string(ly->GetRuntimeClass()->className) == "mola::KeyframePointCloudMap") {
+        kfms.emplace_back(nome, static_cast<const KeyframePointCloudMap *>(ly.get()));
+      }
+    }
+    w.u64(kfms.size());
+    for (const auto & [nome, m] : kfms) {
+      w.stringa(nome);
+      const auto & kfs = m->*get(KfmKeyframes{});
+      w.u64(kfs.size());
+      for (const auto & [id, kf] : kfs) {
+        w.u64(id);
+        w.tempo(kf.timestamp);
+        w.posa(kf.pose());
+      }
+      const auto & last = m->*get(KfmLastInserted{});
+      w.u8(last.has_value());
+      w.u64(last.value_or(0));
+      w.u64(m->*get(KfmNextFree{}));
+      const auto & ev = m->*get(KfmEvicted{});
+      w.u64(ev.size());
+      for (const auto e : ev) w.u64(e);
+
+      // ICP cache: the .mm file stores icp_search_kfs but loading discards it, and
+      // without the submap the first scan after loading would rebuild it.
+      // Selection, submap and auxiliary caches are saved as they are.
+      auto lckKfm = mrpt::lockHelper(*(m->*get(KfmMtx{})));
+      const auto & c = m->*get(KfmCached{});
+      w.u8(c.icp_search_kfs.has_value());
+      if (c.icp_search_kfs) {
+        w.u64(c.icp_search_kfs->size());
+        for (const auto id : *c.icp_search_kfs) w.u64(id);
+      }
+      w.u8(c.icp_search_built_approximate);
+      bboxScrivi(w, c.boundingBox);
+      w.u8(c.icp_search_submap.has_value());
+      if (c.icp_search_submap) submapScrivi(w, *c.icp_search_submap);
+    }
+  }
+  const std::size_t fineMappa = w.buf.size();
+
+  // 8: state estimator
+  sezione(w, 8);
+  w.u8(static_cast<bool>(state_.navstate_fuse));
+  if (state_.navstate_fuse) {
+    auto fn = reinterpret_cast<FnSalvaSes>(simboloSes("mola_ses_full_state_save"));
+    richiedi(fn != nullptr, "funzioni dello stimatore non trovate");
+    std::string dati, errore;
+    const int rc =
+      fn(static_cast<const NavStateFilter *>(state_.navstate_fuse.get()), &dati, &errore);
+    if (rc != 0) {
+      throw std::runtime_error("stato completo: stimatore, " + errore);
+    }
+    w.stringa(dati);
+  }
+
+  if (impronte) {
+    (*impronte)[0] = fnv1a(w.buf.substr(inizioCorpo, fineLo - inizioCorpo));
+    (*impronte)[1] = fnv1a(w.buf.substr(fineLo, fineMappa - fineLo));
+    (*impronte)[2] = fnv1a(w.buf.substr(fineMappa));
+  }
+  return std::move(w.buf);
+}
+
+void LidarOdometry::fullStateDeserialize(const std::string & blob)
+{
+  // Caller holds state_mtx_.
+  Lettore r(blob);
+  char magic[sizeof(MAGIC)];
+  r.grezzo(magic, sizeof(magic));
+  if (std::memcmp(magic, MAGIC, sizeof(MAGIC)) != 0) {
+    throw std::runtime_error("stato completo: file non riconosciuto");
+  }
+  if (r.pod<uint32_t>() != VERSIONE) throw std::runtime_error("stato completo: versione diversa");
+  (void)r.u8();
+  (void)r.pod<int64_t>();
+
+  sezione(r, 1);
+  state_.initial_localization_done = r.u8();
+  if (r.u8()) {
+    const double a = r.f64();
+    const double b = r.f64();
+    state_.gravity_calib_pitch_roll = std::make_pair(a, b);
+  } else {
+    state_.gravity_calib_pitch_roll.reset();
+  }
+  state_.gravity_calib_first_available_time = r.f64Opt();
+  if (r.u8()) {
+    state_.gravity_calib_pose = r.posa();
+  } else {
+    state_.gravity_calib_pose.reset();
+  }
+  r.posaPdf(state_.last_lidar_pose);
+  state_.last_obs_tim_by_label.clear();
+  for (uint64_t i = 0, n = r.u64(); i < n; i++) {
+    auto k = r.stringa();
+    state_.last_obs_tim_by_label[k] = r.tempo();
+  }
+  state_.last_lidar_sensor_poses.clear();
+  for (uint64_t i = 0, n = r.u64(); i < n; i++) {
+    auto k = r.stringa();
+    state_.last_lidar_sensor_poses[k] = r.posa();
+  }
+  state_.last_icp_was_good = r.u8();
+  state_.last_icp_quality = r.f64();
+  state_.last_icp_iterations = r.u64();
+  state_.first_ever_timestamp = r.tempoOpt();
+  state_.last_obs_timestamp = r.tempoOpt();
+  state_.last_icp_timestamp = r.tempoOpt();
+  state_.last_observed_scan_period_sec = r.f64();
+  // wall-clock fields
+  state_.last_obs_reception_time = mrpt::Clock::now();
+  state_.waiting_for_state_estimator_since.reset();
+
+  if (r.u8()) {
+    NavState ns;
+    r.posaPdfInf(ns.pose);
+    ns.twist = r.twist();
+    r.matrice(ns.twist_inv_cov);
+    state_.last_motion_model_output = ns;
+  } else {
+    state_.last_motion_model_output.reset();
+  }
+
+  state_.adapt_thres_sigma = r.f64();
+  state_.consecutive_bad_icps = r.pod<int32_t>();
+  state_.registrations_attempted = r.u64();
+  state_.registration_no_motion_model = r.u64();
+  state_.registration_icp_rejected = r.u64();
+  state_.estimated_observation_radius = r.f64Opt();
+  state_.instantaneous_observation_radius = r.f64Opt();
+  state_.map_has_been_loaded = r.u8();
+
+  state_.localmap_check_removal_counter = r.pod<uint32_t>();
+  state_.localmap_advertise_updates_counter = r.pod<uint32_t>();
+  state_.local_map_needs_viz_update = r.u8();
+  state_.local_map_needs_publish = r.u8();
+  state_.local_map_georef_needs_publish = r.u8();
+  state_.last_yaw_for_viz_camera = r.f64Opt();
+  state_.step_counter_post_relocalization = r.pod<uint32_t>();
+  state_.mapUpdateCnt = r.pod<uint32_t>();
+
+  state_.recent_lidar_stamps.clear();
+  for (uint64_t i = 0, n = r.u64(); i < n; i++) {
+    auto k = r.stringa();
+    // the capacity is the first field written for the buffer
+    const auto cap = r.pod<uint64_t>();
+    auto [it, nuovo] = state_.recent_lidar_stamps.try_emplace(k, cap);
+    const auto nb = r.u64();
+    it->second.clear();
+    for (uint64_t j = 0; j < nb; j++) it->second.push(r.pod<double>());
+  }
+  bufferCircolareLeggi(r, state_.recent_gnss_stamps);
+
+  sezione(r, 2);
+  {
+    const bool hasLocal = r.u8();
+    if (hasLocal) {
+      state_.kf_decider_local_map.emplace(params_.local_map_updates);
+      state_.kf_decider_local_map->loadFullState(r.stringa());
+    } else {
+      state_.kf_decider_local_map.reset();
+    }
+    const bool hasSm = r.u8();
+    if (hasSm) {
+      state_.kf_decider_simplemap.emplace(params_.simplemap);
+      state_.kf_decider_simplemap->loadFullState(r.stringa());
+    } else {
+      state_.kf_decider_simplemap.reset();
+    }
+  }
+
+  sezione(r, 3);
+  {
+    auto lckImu = mrpt::lockHelper(imu_state_mtx_);
+    r.posa(state_.gravity_estimator.imu_sensor_pose);
+    state_.gravity_estimator.imu_sensor_pose_timestamp = r.f64();
+    pending_imu_.*get(PibConsumed{}) = r.f64();
+    bufferCircolareLeggi(r, state_.recent_imu_stamps);
+
+    for (uint64_t i = 0, n = r.u64(); i < n; i++) {
+      auto k = r.stringa();
+      state_.parameter_source.updateVariable(k, r.f64());
+    }
+    auto & lvb = state_.parameter_source.localVelocityBuffer;
+    lvb.parameters.max_time_window = r.f64();
+    lvb.*get(LvbRefTime{}) = r.f64();
+    vettori3Leggi(r, lvb.*get(LvbLinVel{}));
+    vettori3Leggi(r, lvb.*get(LvbAngVel{}));
+    vettori3Leggi(r, lvb.*get(LvbLinAcc{}));
+    auto & orient = lvb.*get(LvbOrient{});
+    orient.clear();
+    for (uint64_t i = 0, n = r.u64(); i < n; i++) {
+      const double t = r.f64();
+      mrpt::math::CMatrixDouble33 R;
+      r.matrice(R);
+      orient.emplace(t, R);
+    }
+  }
+
+  sezione(r, 4);
+  {
+    auto lckWait = mrpt::lockHelper(worker_lidar_wait_for_imu_list_mtx_);
+    last_lidar_arrival_stamp_ = r.f64();
+  }
+  latest_imu_time_.store(r.f64());
+  latest_obs_time_.store(r.f64());
+  lidar_scan_period_.store(r.f64());
+  params_.optimize_twist_max_corrections = static_cast<std::size_t>(r.u64());
+  {
+    auto lckDrop = mrpt::lockHelper(drop_stats_mtx_);
+    for (std::size_t i = 0; i < MethodState::DROP_STATS_WINDOW_LENGTH; i++) {
+      state_.drop_frames_stats_good[i] = r.u8();
+      state_.drop_frames_stats_dropped[i] = r.u8();
+    }
+    state_.drop_frames_stats_next_index = static_cast<std::size_t>(r.u64());
+  }
+
+  sezione(r, 5);
+  {
+    auto lckTraj = mrpt::lockHelper(state_trajectory_mtx_);
+    state_.estimated_trajectory.clear();
+    for (uint64_t i = 0, n = r.u64(); i < n; i++) {
+      const auto t = r.tempo();
+      state_.estimated_trajectory.insert(t, r.tposa());
+    }
+  }
+
+  sezione(r, 6);
+  {
+    auto lckSm = mrpt::lockHelper(state_simplemap_mtx_);
+    auto & sm = state_.reconstructed_simplemap;
+    deserializzaMrpt(r.stringa(), sm);
+    state_.past_simplemaps_observations.clear();
+    for (uint64_t i = 0, n = r.u64(); i < n; i++) {
+      const auto t = r.tempo();
+      const auto idx = r.u64();
+      if (idx >= sm.size()) throw std::runtime_error("stato completo: indice del simplemap");
+      state_.past_simplemaps_observations[t] = sm.get(idx).sf;
+    }
+  }
+
+  sezione(r, 7);
+  {
+    auto lckMap = mrpt::lockHelper(local_map_content_mtx_);
+    ASSERT_(state_.local_map);
+    // In a fresh MOLA the layer classes (e.g. mola::KeyframePointCloudMap) are
+    // registered only when the generator creates the map at the first keyframe:
+    // creating a temporary map loads the plugin without touching the state.
+    {
+      mp2p_icp::metric_map_t tmp;
+      for (const auto & g : state_.local_map_generators) {
+        if (g) g->createTargetLayerIfNeeded(tmp);
+      }
+    }
+    deserializzaMrpt(r.stringa(), *state_.local_map);
+    for (uint64_t i = 0, n = r.u64(); i < n; i++) {
+      const auto nome = r.stringa();
+      auto itLy = state_.local_map->layers.find(nome);
+      if (
+        itLy == state_.local_map->layers.end() || !itLy->second ||
+        std::string(itLy->second->GetRuntimeClass()->className) != "mola::KeyframePointCloudMap") {
+        throw std::runtime_error("stato completo: layer della mappa assente: " + nome);
+      }
+      auto * m = static_cast<KeyframePointCloudMap *>(itLy->second.get());
+      auto & kfs = m->*get(KfmKeyframes{});
+      const auto nKf = r.u64();
+      if (nKf != kfs.size()) throw std::runtime_error("stato completo: numero di keyframe diverso");
+      for (uint64_t j = 0; j < nKf; j++) {
+        const auto id = r.u64();
+        const auto t = r.tempo();
+        auto itKf = kfs.find(id);
+        if (itKf == kfs.end() || itKf->second.timestamp != t) {
+          throw std::runtime_error("stato completo: keyframe " + std::to_string(id) + " diverso");
+        }
+        // exact pose, with the yaw/pitch/roll cache as it was at save time
+        itKf->second.pose(r.posa());
+      }
+      const bool hasLast = r.u8();
+      const auto last = r.u64();
+      m->*get(KfmLastInserted{}) = hasLast ? std::optional<uint64_t>(last) : std::nullopt;
+      m->*get(KfmNextFree{}) = r.u64();
+      auto & ev = m->*get(KfmEvicted{});
+      ev.clear();
+      for (uint64_t j = 0, ne = r.u64(); j < ne; j++) ev.push_back(r.u64());
+
+      // ICP cache, after the keyframe poses (the setter does not touch it)
+      auto lckKfm = mrpt::lockHelper(*(m->*get(KfmMtx{})));
+      auto & c = m->*get(KfmCached{});
+      if (r.u8()) {
+        std::set<KeyframePointCloudMap::KeyFrameID> ids;
+        for (uint64_t j = 0, ni = r.u64(); j < ni; j++) ids.insert(r.u64());
+        c.icp_search_kfs = std::move(ids);
+      } else {
+        c.icp_search_kfs.reset();
+      }
+      c.icp_search_built_approximate = r.u8();
+      c.boundingBox = bboxLeggi(r);
+      if (r.u8()) {
+        // the constructor arguments are overwritten right after with the saved values
+        c.icp_search_submap.emplace(0, 0, 0.0);
+        submapLeggi(r, *c.icp_search_submap);
+      } else {
+        c.icp_search_submap.reset();
+      }
+    }
+  }
+
+  sezione(r, 8);
+  if (r.u8()) {
+    ASSERTMSG_(state_.navstate_fuse, "stato completo: stimatore assente in questa istanza");
+    auto fn = reinterpret_cast<FnCaricaSes>(simboloSes("mola_ses_full_state_load"));
+    richiedi(fn != nullptr, "funzioni dello stimatore non trovate");
+    const std::string dati = r.stringa();
+    std::string errore;
+    const int rc = fn(
+      static_cast<NavStateFilter *>(state_.navstate_fuse.get()), &dati,
+      config().twistZero ? 1 : 0, &errore);
+    if (rc != 0) {
+      throw std::runtime_error("stato completo: stimatore, " + errore);
+    }
+  }
+  if (!r.finito()) throw std::runtime_error("stato completo: byte in eccesso a fine file");
+}
+
+void LidarOdometry::fullStateSaveToFile(
+  const std::string & file, const std::optional<mrpt::Clock::time_point> & stamp)
+{
+  std::string blob, cacheIcp;
+  {
+    auto lckState = mrpt::lockHelper(state_mtx_);
+    blob = fullStateSerialize(stamp, nullptr);
+    auto lckMap = mrpt::lockHelper(local_map_content_mtx_);
+    if (state_.local_map) cacheIcp = descriviCacheIcp(*state_.local_map);
+  }
+  scriviFile(file, blob);
+  MRPT_LOG_INFO_STREAM(
+    "[full_state] salvato " << file << " (" << blob.size() << " byte, stamp "
+                            << (stamp ? std::to_string(tick(*stamp)) : std::string("nessuno"))
+                            << ")" << cacheIcp);
+}
+
+void LidarOdometry::fullStateLoadFromFile(const std::string & file)
+{
+  const std::string blob = leggiFile(file);
+  std::string cacheIcp;
+  {
+    auto lckState = mrpt::lockHelper(state_mtx_);
+    fullStateDeserialize(blob);
+    auto lckMap = mrpt::lockHelper(local_map_content_mtx_);
+    if (state_.local_map) cacheIcp = descriviCacheIcp(*state_.local_map);
+  }
+  MRPT_LOG_INFO_STREAM(
+    "[full_state] caricato " << file << " (" << blob.size() << " byte)" << cacheIcp);
+
+  if (!config().risalva.empty()) {
+    std::optional<mrpt::Clock::time_point> stamp;
+    Lettore r(blob);
+    char magic[sizeof(MAGIC)];
+    r.grezzo(magic, sizeof(magic));
+    (void)r.pod<uint32_t>();
+    if (r.u8()) {
+      stamp = mrpt::Clock::time_point(mrpt::Clock::duration(r.pod<int64_t>()));
+    }
+    fullStateSaveToFile(config().risalva, stamp);
+  }
+}
+
+bool LidarOdometry::fullStateOnObservation(const CObservation::ConstPtr & o)
+{
+  if (!config().attivo) {
+    return true;
+  }
+  auto & e = esecuzione();
+  if (!e.caricamentoInAttesa) {
+    // negative control: fresh MOLA starting from the first scan after t
+    return config().saltaFinoA == 0 || tick(o->timestamp) > config().saltaFinoA;
+  }
+  if (!e.stampLetto) {
+    const std::string blob = leggiFile(config().carica);
+    Lettore r(blob);
+    char magic[sizeof(MAGIC)];
+    r.grezzo(magic, sizeof(magic));
+    if (std::memcmp(magic, MAGIC, sizeof(MAGIC)) != 0 || r.pod<uint32_t>() != VERSIONE) {
+      throw std::runtime_error("stato completo: file non riconosciuto " + config().carica);
+    }
+    if (!r.u8()) throw std::runtime_error("stato completo: file senza stamp " + config().carica);
+    e.stampSalvato = r.pod<int64_t>();
+    e.stampLetto = true;
+  }
+  // inputs already processed by the instance that saved the state: dropped
+  if (tick(o->timestamp) <= e.stampSalvato) {
+    return false;
+  }
+  e.caricamentoInAttesa = false;
+  fullStateLoadFromFile(config().carica);
+  return true;
+}
+
+void LidarOdometry::fullStateAfterScan(const CObservation::ConstPtr & o)
+{
+  const auto & c = config();
+  if (!c.attivo || !o) {
+    return;
+  }
+  const int64_t t = tick(o->timestamp);
+
+  if (!c.traccia.empty()) {
+    auto & e = esecuzione();
+    if (!e.tracciaAperta) {
+      e.traccia.open(c.traccia, std::ios::out | std::ios::trunc);
+      e.traccia << "stamp_tick,stamp_s,n_traiettoria,kf_locale,kf_simplemap,init_fatta,icp_buono,"
+                   "step_post_riloc,icp_cattivi,contatore_rimozione,max_correzioni_twist,"
+                   "x,y,z,R00,R10,sigma,raggio_stimato,raggio_istantaneo,"
+                   "impronta_lo,impronta_mappa,impronta_stimatore\n";
+      e.tracciaAperta = true;
+    }
+    std::array<uint64_t, 3> imp{};
+    std::string riga;
+    try {
+      auto lckState = mrpt::lockHelper(state_mtx_);
+      (void)fullStateSerialize(state_.last_obs_timestamp, &imp);
+      const auto & p = state_.last_lidar_pose.mean;
+      const auto & R = p.*AccessoPosa::rot();
+      char b[1024];
+      std::snprintf(
+        b, sizeof(b),
+        "%lld,%.9f,%zu,%zu,%zu,%d,%d,%u,%d,%u,%zu,%a,%a,%a,%a,%a,%a,%a,%a,%016llx,%016llx,%016llx\n",
+        static_cast<long long>(t), mrpt::Clock::toDouble(o->timestamp),
+        state_.estimated_trajectory.size(),
+        state_.kf_decider_local_map ? state_.kf_decider_local_map->size() : 0,
+        state_.kf_decider_simplemap ? state_.kf_decider_simplemap->size() : 0,
+        state_.initial_localization_done ? 1 : 0, state_.last_icp_was_good ? 1 : 0,
+        state_.step_counter_post_relocalization, state_.consecutive_bad_icps,
+        state_.localmap_check_removal_counter, params_.optimize_twist_max_corrections,
+        p.m_coords[0], p.m_coords[1], p.m_coords[2], R(0, 0), R(1, 0), state_.adapt_thres_sigma,
+        state_.estimated_observation_radius.value_or(-1.0),
+        state_.instantaneous_observation_radius.value_or(-1.0),
+        static_cast<unsigned long long>(imp[0]), static_cast<unsigned long long>(imp[1]),
+        static_cast<unsigned long long>(imp[2]));
+      riga = b;
+    } catch (const std::exception & ex) {
+      riga = std::to_string(t) + ",errore\n";
+      MRPT_LOG_ERROR_STREAM("[full_state] traccia: " << ex.what());
+    }
+    e.traccia << riga;
+    e.traccia.flush();
+  }
+
+  if (c.salvaAiTick.count(t) != 0) {
+    const std::string f = c.cartella + "/stato_" + std::to_string(t) + ".molastate";
+    try {
+      fullStateSaveToFile(f, o->timestamp);
+      if (c.salvaMm) {
+        // Inputs for the negative control: map as map_save_impl, pose
+        // (x, y, z in m; yaw, pitch, roll in deg) and sigma of the same scan.
+        auto lckState = mrpt::lockHelper(state_mtx_);
+        auto lckMap = mrpt::lockHelper(local_map_content_mtx_);
+        if (!state_.local_map->save_to_file(f + ".mm")) {
+          throw std::runtime_error("scrittura del .mm fallita");
+        }
+        // copy: yaw() updates the ypr cache, which is part of the state
+        const mrpt::poses::CPose3D p = state_.last_lidar_pose.mean;
+        char b[512];
+        std::snprintf(
+          b, sizeof(b), "x %.17g\ny %.17g\nz %.17g\nyaw_deg %.17g\npitch_deg %.17g\nroll_deg %.17g\nsigma %.17g\n",
+          p.x(), p.y(), p.z(), mrpt::RAD2DEG(p.yaw()), mrpt::RAD2DEG(p.pitch()),
+          mrpt::RAD2DEG(p.roll()), state_.adapt_thres_sigma);
+        scriviFile(f + ".posa.txt", b);
+      }
+    } catch (const std::exception & ex) {
+      MRPT_LOG_ERROR_STREAM("[full_state] salvataggio fallito: " << ex.what());
+    }
+  }
+}
+
+bool LidarOdometry::fullStateMapSave(const std::string & path)
+{
+  if (!config().attivo) {
+    return true;
+  }
+  try {
+    std::optional<mrpt::Clock::time_point> stamp;
+    {
+      auto lckState = mrpt::lockHelper(state_mtx_);
+      stamp = state_.last_obs_timestamp;
+    }
+    fullStateSaveToFile(path + ".molastate", stamp);
+    return true;
+  } catch (const std::exception & ex) {
+    MRPT_LOG_ERROR_STREAM("[full_state] salvataggio fallito: " << ex.what());
+    return false;
+  }
+}
+
+bool LidarOdometry::fullStateMapLoad(const std::string & path)
+{
+  if (!config().attivo) {
+    return true;
+  }
+  const std::string f = path + ".molastate";
+  if (!mrpt::system::fileExists(f)) {
+    MRPT_LOG_ERROR_STREAM("[full_state] file di stato assente: " << f);
+    return false;
+  }
+  try {
+    fullStateLoadFromFile(f);
+    return true;
+  } catch (const std::exception & ex) {
+    MRPT_LOG_ERROR_STREAM("[full_state] caricamento fallito: " << ex.what());
+    return false;
+  }
+}
+
