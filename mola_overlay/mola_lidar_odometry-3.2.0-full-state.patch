+// ---------------------------------------------------------------------------
+// KeyframeDecider
+// ---------------------------------------------------------------------------
+void KeyframeDecider::saveFullState(std::string & out) const
+{
+  Scrittore w;
+  w.u8(from_last_only_);
+  w.u8(temporal_);
+  w.u64(created_);
+  w.u64(recent_.size());
+  for (const auto & [t, p] : recent_) {
+    w.f64(t);
+    w.posa(p);
+  }
+  const auto & spl = poses_;
+  w.u8(spl.*get(SplFromLastOnly{}));
+  w.u8(spl.*get(SplHasLastKf{}));
+  w.posa(spl.*get(SplLastKf{}));
+  const auto & kfPoses = spl.*get(SplKfPoses{});
+  w.u64(kfPoses.size());
+  for (const auto & p : kfPoses) w.posa(p);
+  const auto & pts = spl.*get(SplKfPoints{});
+  const auto & xs = pts.getPointsBufferRef_x();
+  const auto & ys = pts.getPointsBufferRef_y();
+  const auto & zs = pts.getPointsBufferRef_z();
+  w.u64(pts.size());
+  for (std::size_t i = 0; i < pts.size(); i++) {
+    w.pod<float>(xs[i]);
+    w.pod<float>(ys[i]);
+    w.pod<float>(zs[i]);
+  }
+  const auto & ids = spl.*get(SplKfIds{});
+  w.u64(ids.size());
+  for (const auto & id : ids) {
+    w.u8(id.has_value());
+    w.u64(id.value_or(0));
+  }
+  const auto & idx = spl.*get(SplIdToIdx{});
+  w.u64(idx.size());
+  for (const auto & [k, v] : idx) {
+    w.u64(k);
+    w.u64(v);
+  }
+  out = std::move(w.buf);
+}
+
+void KeyframeDecider::loadFullState(const std::string & in)
+{
+  Lettore r(in);
+  if (r.u8() != from_last_only_ || r.u8() != temporal_) {
+    throw std::runtime_error("stato completo: KeyframeDecider con opzioni diverse");
+  }
+  created_ = r.u64();
+  recent_.clear();
+  const auto nRecent = r.u64();
+  for (uint64_t i = 0; i < nRecent; i++) {
+    const double t = r.f64();
+    recent_.emplace_back(t, r.posa());
+  }
+  auto & spl = poses_;
+  if (r.u8() != spl.*get(SplFromLastOnly{})) {
+    throw std::runtime_error("stato completo: SearchablePoseList con opzioni diverse");
+  }
+  spl.*get(SplHasLastKf{}) = r.u8();
+  r.posa(spl.*get(SplLastKf{}));
+  auto & kfPoses = spl.*get(SplKfPoses{});
+  kfPoses.clear();
+  const auto nPoses = r.u64();
+  for (uint64_t i = 0; i < nPoses; i++) kfPoses.push_back(r.posa());
+  auto & pts = spl.*get(SplKfPoints{});
+  pts.clear();
+  const auto nPts = r.u64();
+  for (uint64_t i = 0; i < nPts; i++) {
+    const float x = r.pod<float>();
+    const float y = r.pod<float>();
+    const float z = r.pod<float>();
+    pts.insertPoint(x, y, z);
+  }
+  auto & ids = spl.*get(SplKfIds{});
+  ids.clear();
+  const auto nIds = r.u64();
+  for (uint64_t i = 0; i < nIds; i++) {
+    const bool has = r.u8();
+    const auto v = r.u64();
+    ids.push_back(has ? std::optional<uint64_t>(v) : std::nullopt);
+  }
+  auto & idx = spl.*get(SplIdToIdx{});
+  idx.clear();
+  const auto nIdx = r.u64();
+  for (uint64_t i = 0; i < nIdx; i++) {
+    const auto k = r.u64();
+    idx[k] = static_cast<std::size_t>(r.u64());
+  }
+  if (!r.finito()) throw std::runtime_error("stato completo: KeyframeDecider, byte in eccesso");
+}
