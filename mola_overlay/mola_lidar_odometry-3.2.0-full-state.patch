diff -ruN a/mola_lidar_odometry/module/src/FullStateIO.h b/mola_lidar_odometry/module/src/FullStateIO.h
--- a/mola_lidar_odometry/module/src/FullStateIO.h
+++ b/mola_lidar_odometry/module/src/FullStateIO.h
@@ -0,0 +1,266 @@
+/* Full state: hand-written binary writer and reader.
+ *
+ * Internal header, not installed. Doubles are copied byte by byte (no text);
+ * CPose3D poses are written with coordinates, rotation matrix and the cached
+ * yaw/pitch/roll, which MRPT serialization does not preserve.
+ */
+#pragma once
+
+#include <mrpt/core/Clock.h>
+#include <mrpt/core/exceptions.h>
+#include <mrpt/math/CMatrixFixed.h>
+#include <mrpt/math/TPose3D.h>
+#include <mrpt/math/TTwist3D.h>
+#include <mrpt/poses/CPose3D.h>
+#include <mrpt/poses/CPose3DPDFGaussian.h>
+#include <mrpt/poses/CPose3DPDFGaussianInf.h>
+
+#include <cstdint>
+#include <cstring>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+
+namespace mola::full_state
+{
+// Access to non-public members of external classes: explicit template
+// instantiation is not subject to access checking.
+template <typename Tag, auto M>
+struct Ruba
+{
+  friend auto get(Tag) { return M; }
+};
+
+#define MOLA_FS_ACCESSO(Tag, Membro) \
+  struct Tag                         \
+  {                                  \
+    friend auto get(Tag);            \
+  };                                 \
+  template struct ::mola::full_state::Ruba<Tag, &Membro>
+
+// Protected members of CPose3D, reached through a derived class.
+struct AccessoPosa : public mrpt::poses::CPose3D
+{
+  static auto rot() { return &AccessoPosa::m_ROT; }
+  static auto yprAggiornata() { return &AccessoPosa::m_ypr_uptodate; }
+  static auto yaw() { return &AccessoPosa::m_yaw; }
+  static auto pitch() { return &AccessoPosa::m_pitch; }
+  static auto roll() { return &AccessoPosa::m_roll; }
+};
+
+class Scrittore
+{
+public:
+  std::string buf;
+
+  void grezzo(const void * p, std::size_t n) { buf.append(static_cast<const char *>(p), n); }
+
+  template <typename T>
+  void pod(const T & v)
+  {
+    static_assert(std::is_trivially_copyable_v<T>);
+    grezzo(&v, sizeof(T));
+  }
+
+  void u8(bool b) { pod<uint8_t>(b ? 1 : 0); }
+  void u64(uint64_t v) { pod(v); }
+  void f64(double v) { pod(v); }
+
+  void stringa(const std::string & s)
+  {
+    u64(s.size());
+    grezzo(s.data(), s.size());
+  }
+
+  void tempo(const mrpt::Clock::time_point & t)
+  {
+    pod<int64_t>(static_cast<int64_t>(t.time_since_epoch().count()));
+  }
+
+  void tempoOpt(const std::optional<mrpt::Clock::time_point> & t)
+  {
+    u8(t.has_value());
+    if (t) tempo(*t);
+  }
+
+  void f64Opt(const std::optional<double> & v)
+  {
+    u8(v.has_value());
+    if (v) f64(*v);
+  }
+
+  template <std::size_t R, std::size_t C>
+  void matrice(const mrpt::math::CMatrixFixed<double, R, C> & m)
+  {
+    for (std::size_t r = 0; r < R; r++)
+      for (std::size_t c = 0; c < C; c++) f64(m(r, c));
+  }
+
+  void posa(const mrpt::poses::CPose3D & p)
+  {
+    for (int i = 0; i < 3; i++) f64(p.m_coords[i]);
+    matrice(p.*AccessoPosa::rot());
+    u8(p.*AccessoPosa::yprAggiornata());
+    f64(p.*AccessoPosa::yaw());
+    f64(p.*AccessoPosa::pitch());
+    f64(p.*AccessoPosa::roll());
+  }
+
+  void posaPdf(const mrpt::poses::CPose3DPDFGaussian & p)
+  {
+    posa(p.mean);
+    matrice(p.cov);
+  }
+
+  void posaPdfInf(const mrpt::poses::CPose3DPDFGaussianInf & p)
+  {
+    posa(p.mean);
+    matrice(p.cov_inv);
+  }
+
+  void tposa(const mrpt::math::TPose3D & p)
+  {
+    f64(p.x);
+    f64(p.y);
+    f64(p.z);
+    f64(p.yaw);
+    f64(p.pitch);
+    f64(p.roll);
+  }
+
+  void twist(const mrpt::math::TTwist3D & t)
+  {
+    f64(t.vx);
+    f64(t.vy);
+    f64(t.vz);
+    f64(t.wx);
+    f64(t.wy);
+    f64(t.wz);
+  }
+};
+
+class Lettore
+{
+public:
+  explicit Lettore(const std::string & b) : buf_(b) {}
+
+  void grezzo(void * p, std::size_t n)
+  {
+    if (pos_ + n > buf_.size()) {
+      throw std::runtime_error("stato completo: file troncato");
+    }
+    std::memcpy(p, buf_.data() + pos_, n);
+    pos_ += n;
+  }
+
+  template <typename T>
+  T pod()
+  {
+    static_assert(std::is_trivially_copyable_v<T>);
+    T v;
+    grezzo(&v, sizeof(T));
+    return v;
+  }
+
+  bool u8() { return pod<uint8_t>() != 0; }
+  uint64_t u64() { return pod<uint64_t>(); }
+  double f64() { return pod<double>(); }
+
+  std::string stringa()
+  {
+    const auto n = u64();
+    if (pos_ + n > buf_.size()) {
+      throw std::runtime_error("stato completo: stringa oltre la fine del file");
+    }
+    std::string s(buf_.data() + pos_, n);
+    pos_ += n;
+    return s;
+  }
+
+  mrpt::Clock::time_point tempo()
+  {
+    return mrpt::Clock::time_point(mrpt::Clock::duration(pod<int64_t>()));
+  }
+
+  std::optional<mrpt::Clock::time_point> tempoOpt()
+  {
+    if (!u8()) return std::nullopt;
+    return tempo();
+  }
+
+  std::optional<double> f64Opt()
+  {
+    if (!u8()) return std::nullopt;
+    return f64();
+  }
+
+  template <std::size_t R, std::size_t C>
+  void matrice(mrpt::math::CMatrixFixed<double, R, C> & m)
+  {
+    for (std::size_t r = 0; r < R; r++)
+      for (std::size_t c = 0; c < C; c++) m(r, c) = f64();
+  }
+
+  void posa(mrpt::poses::CPose3D & p)
+  {
+    for (int i = 0; i < 3; i++) p.m_coords[i] = f64();
+    matrice(p.*AccessoPosa::rot());
+    p.*AccessoPosa::yprAggiornata() = u8();
+    p.*AccessoPosa::yaw() = f64();
+    p.*AccessoPosa::pitch() = f64();
+    p.*AccessoPosa::roll() = f64();
+  }
+
+  mrpt::poses::CPose3D posa()
+  {
+    mrpt::poses::CPose3D p;
+    posa(p);
+    return p;
+  }
+
+  void posaPdf(mrpt::poses::CPose3DPDFGaussian & p)
+  {
+    posa(p.mean);
+    matrice(p.cov);
+  }
+
+  void posaPdfInf(mrpt::poses::CPose3DPDFGaussianInf & p)
+  {
+    posa(p.mean);
+    matrice(p.cov_inv);
+  }
+
+  mrpt::math::TPose3D tposa()
+  {
+    mrpt::math::TPose3D p;
+    p.x = f64();
+    p.y = f64();
+    p.z = f64();
+    p.yaw = f64();
+    p.pitch = f64();
+    p.roll = f64();
+    return p;
+  }
+
+  mrpt::math::TTwist3D twist()
+  {
+    mrpt::math::TTwist3D t;
+    t.vx = f64();
+    t.vy = f64();
+    t.vz = f64();
+    t.wx = f64();
+    t.wy = f64();
+    t.wz = f64();
+    return t;
+  }
+
+  std::size_t posizione() const { return pos_; }
+  bool finito() const { return pos_ == buf_.size(); }
+
+private:
+  const std::string & buf_;
+  std::size_t pos_ = 0;
+};
+
+}  // namespace mola::full_state
diff -ruN a/mola_lidar_odometry/module/src/LidarOdometry_FullState.cpp b/mola_lidar_odometry/module/src/LidarOdometry_FullState.cpp
--- a/mola_lidar_odometry/module/src/LidarOdometry_FullState.cpp
+++ b/mola_lidar_odometry/module/src/LidarOdometry_FullState.cpp
@@ -0,0 +1,1254 @@
+/* Full state of LidarOdometry and of the state estimator.
+ *
+ * Saves and reloads in binary all the state that affects the processing of
+ * later scans, so that it can be moved from the shadow MOLA instance to the
+ * twin instance. Enabled only with MOLA_FULL_STATE=1; when disabled every hook
+ * returns immediately and processing is unchanged.
+ *
+ * Environment variables (read once):
+ *  MOLA_FULL_STATE=1                    enable
+ *  MOLA_FULL_STATE_SAVE_AT_TICKS=a,b,.. save after the scan with this stamp
+ *                                       (mrpt::Clock ticks, 100 ns)
+ *  MOLA_FULL_STATE_SAVE_DIR=<dir>       output directory (default ".")
+ *  MOLA_FULL_STATE_LOAD=<file>          drop inputs with stamp <= the saved
+ *                                       one, load the state at the first
+ *                                       later input
+ *  MOLA_FULL_STATE_RESAVE=<file>        save again right after loading
+ *  MOLA_FULL_STATE_TRACE=<file>         one line per scan with its fingerprint
+ *  MOLA_FULL_STATE_PROVA_TWIST_ZERO=1   negative control: estimator twist set
+ *                                       to zero on load
+ *  MOLA_FULL_STATE_SKIP_UNTIL_TICKS=t   offline tests only: drop inputs with
+ *                                       stamp <= t without loading anything
+ *                                       (negative control)
+ *  MOLA_FULL_STATE_SAVE_MM=1            on every save also write <file>.mm
+ *                                       (as map_save) and <file>.posa.txt
+ *                                       (pose and sigma)
+ *
+ * Wall-clock fields, closed list: last_obs_reception_time (set to now() on
+ * load) and waiting_for_state_estimator_since (reset).
+ * Excluded because used only for visualization or publishing: glVehicleModels,
+ * glVehicleModelsLoaded, glEstimatedPath, last_deskewed_scan_for_publishing.
+ * IMU state, GNSS, multi-LiDAR synchronization and external georeferencing
+ * are not handled: if any of them is non-empty the save is refused.
+ * For the keyframe map the ICP cache is saved too (selection, submap,
+ * bounding box); only the visualization caches (cachedPoints, cached_viz_,
+ * cachez_viz_covs_) and the point cloud KD-trees are left out, the latter
+ * rebuilt from the same points at the first search.
+ */
+
+#include <mola_lidar_odometry/LidarOdometry.h>
+#include <mola_metric_maps/KeyframePointCloudMap.h>
+#include <mrpt/core/lock_helper.h>
+#include <mrpt/io/CMemoryStream.h>
+#include <mrpt/serialization/CArchive.h>
+#include <mrpt/system/filesystem.h>
+
+#include <dlfcn.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <set>
+#include <sstream>
+
+#include "FullStateIO.h"
+
+namespace mola::full_state
+{
+// Private members of external classes (explicit instantiation only).
+MOLA_FS_ACCESSO(SplLastKf, mola::SearchablePoseList::last_kf_);
+MOLA_FS_ACCESSO(SplHasLastKf, mola::SearchablePoseList::has_last_kf_);
+MOLA_FS_ACCESSO(SplKfPoses, mola::SearchablePoseList::kf_poses_);
+MOLA_FS_ACCESSO(SplKfPoints, mola::SearchablePoseList::kf_points_);
+MOLA_FS_ACCESSO(SplKfIds, mola::SearchablePoseList::kf_ids_);
+MOLA_FS_ACCESSO(SplIdToIdx, mola::SearchablePoseList::id_to_idx_);
+MOLA_FS_ACCESSO(SplFromLastOnly, mola::SearchablePoseList::from_last_only_);
+
+MOLA_FS_ACCESSO(KfmKeyframes, mola::KeyframePointCloudMap::keyframes_);
+MOLA_FS_ACCESSO(KfmLastInserted, mola::KeyframePointCloudMap::last_inserted_kf_id_);
+MOLA_FS_ACCESSO(KfmEvicted, mola::KeyframePointCloudMap::evicted_kf_ids_);
+MOLA_FS_ACCESSO(KfmNextFree, mola::KeyframePointCloudMap::next_free_kf_id_);
+MOLA_FS_ACCESSO(KfmMtx, mola::KeyframePointCloudMap::state_mtx_);
+MOLA_FS_ACCESSO(KfmCached, mola::KeyframePointCloudMap::cached_);
+
+// ICP search submap (private KeyFrame of the keyframe map).
+MOLA_FS_ACCESSO(KfKCorr, mola::KeyframePointCloudMap::KeyFrame::k_correspondences_for_cov_);
+MOLA_FS_ACCESSO(KfMinCorr, mola::KeyframePointCloudMap::KeyFrame::min_correspondences_for_cov_);
+MOLA_FS_ACCESSO(KfMaxDist, mola::KeyframePointCloudMap::KeyFrame::max_distance_for_cov_);
+MOLA_FS_ACCESSO(KfPc, mola::KeyframePointCloudMap::KeyFrame::pointcloud_);
+MOLA_FS_ACCESSO(KfPose, mola::KeyframePointCloudMap::KeyFrame::pose_);
+MOLA_FS_ACCESSO(KfBBox, mola::KeyframePointCloudMap::KeyFrame::cached_bbox_local_);
+MOLA_FS_ACCESSO(KfDensity, mola::KeyframePointCloudMap::KeyFrame::cloud_density_);
+MOLA_FS_ACCESSO(KfCovLocal, mola::KeyframePointCloudMap::KeyFrame::cached_cov_local_);
+MOLA_FS_ACCESSO(KfCovGlobal, mola::KeyframePointCloudMap::KeyFrame::cached_cov_global_);
+MOLA_FS_ACCESSO(KfPcGlobal, mola::KeyframePointCloudMap::KeyFrame::pointcloud_global_);
+
+MOLA_FS_ACCESSO(LvbLinVel, mola::imu::LocalVelocityBuffer::linear_velocities_);
+MOLA_FS_ACCESSO(LvbAngVel, mola::imu::LocalVelocityBuffer::angular_velocities_);
+MOLA_FS_ACCESSO(LvbLinAcc, mola::imu::LocalVelocityBuffer::linear_accelerations_);
+MOLA_FS_ACCESSO(LvbOrient, mola::imu::LocalVelocityBuffer::orientations_);
+MOLA_FS_ACCESSO(LvbRefTime, mola::imu::LocalVelocityBuffer::reference_zero_time);
+
+MOLA_FS_ACCESSO(PibSamples, mola::PendingImuBuffer::samples_);
+MOLA_FS_ACCESSO(PibConsumed, mola::PendingImuBuffer::consumed_up_to_);
+
+namespace
+{
+constexpr char MAGIC[8] = {'M', 'O', 'L', 'A', 'F', 'S', '0', '1'};
+// Version 2 includes the ICP cache of the keyframe map (section 7).
+constexpr uint32_t VERSIONE = 2;
+
+struct Config
+{
+  bool attivo = false;
+  std::set<int64_t> salvaAiTick;
+  std::string cartella = ".";
+  std::string carica;
+  std::string risalva;
+  std::string traccia;
+  bool twistZero = false;
+  int64_t saltaFinoA = 0;
+  bool salvaMm = false;
+};
+
+std::string env(const char * nome)
+{
+  const char * v = std::getenv(nome);
+  return v ? std::string(v) : std::string();
+}
+
+const Config & config()
+{
+  static const Config c = []() {
+    Config r;
+    r.attivo = env("MOLA_FULL_STATE") == "1";
+    if (!r.attivo) {
+      return r;
+    }
+    std::stringstream ss(env("MOLA_FULL_STATE_SAVE_AT_TICKS"));
+    std::string tok;
+    while (std::getline(ss, tok, ',')) {
+      if (!tok.empty()) r.salvaAiTick.insert(std::stoll(tok));
+    }
+    if (const auto d = env("MOLA_FULL_STATE_SAVE_DIR"); !d.empty()) r.cartella = d;
+    r.carica = env("MOLA_FULL_STATE_LOAD");
+    r.risalva = env("MOLA_FULL_STATE_RESAVE");
+    r.traccia = env("MOLA_FULL_STATE_TRACE");
+    r.twistZero = env("MOLA_FULL_STATE_PROVA_TWIST_ZERO") == "1";
+    if (const auto s = env("MOLA_FULL_STATE_SKIP_UNTIL_TICKS"); !s.empty()) {
+      r.saltaFinoA = std::stoll(s);
+    }
+    r.salvaMm = env("MOLA_FULL_STATE_SAVE_MM") == "1";
+    return r;
+  }();
+  return c;
+}
+
+// State of the load mechanism (one LidarOdometry instance per process).
+struct Esecuzione
+{
+  bool caricamentoInAttesa = false;
+  bool stampLetto = false;
+  int64_t stampSalvato = 0;
+  std::ofstream traccia;
+  bool tracciaAperta = false;
+};
+
+Esecuzione & esecuzione()
+{
+  static Esecuzione e = []() {
+    Esecuzione r;
+    r.caricamentoInAttesa = !config().carica.empty();
+    return r;
+  }();
+  return e;
+}
+
+int64_t tick(const mrpt::Clock::time_point & t)
+{
+  return static_cast<int64_t>(t.time_since_epoch().count());
+}
+
+uint64_t fnv1a(const std::string & s)
+{
+  uint64_t h = 1469598103934665603ULL;
+  for (const unsigned char c : s) {
+    h ^= c;
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
+
+std::string leggiFile(const std::string & f)
+{
+  std::ifstream in(f, std::ios::binary);
+  if (!in) throw std::runtime_error("stato completo: impossibile aprire " + f);
+  std::ostringstream ss;
+  ss << in.rdbuf();
+  return ss.str();
+}
+
+void scriviFile(const std::string & f, const std::string & dati)
+{
+  std::ofstream out(f, std::ios::binary | std::ios::trunc);
+  if (!out) throw std::runtime_error("stato completo: impossibile scrivere " + f);
+  out.write(dati.data(), static_cast<std::streamsize>(dati.size()));
+  out.close();
+  if (!out) throw std::runtime_error("stato completo: scrittura fallita " + f);
+}
+
+// Section marker: a misaligned read fails immediately.
+void sezione(Scrittore & w, uint32_t id) { w.pod<uint32_t>(0x53450000u | id); }
+void sezione(Lettore & r, uint32_t id)
+{
+  const auto v = r.pod<uint32_t>();
+  if (v != (0x53450000u | id)) {
+    throw std::runtime_error("stato completo: sezione " + std::to_string(id) + " non allineata");
+  }
+}
+
+std::string serializzaMrpt(const mrpt::serialization::CSerializable & o)
+{
+  mrpt::io::CMemoryStream ms;
+  auto arch = mrpt::serialization::archiveFrom(ms);
+  arch << o;
+  return std::string(
+    static_cast<const char *>(ms.getRawBufferData()), static_cast<std::size_t>(ms.getTotalBytesCount()));
+}
+
+void deserializzaMrpt(const std::string & blob, mrpt::serialization::CSerializable & o)
+{
+  mrpt::io::CMemoryStream ms;
+  ms.assignMemoryNotOwn(blob.data(), blob.size());
+  auto arch = mrpt::serialization::archiveFrom(ms);
+  arch >> o;
+}
+
+// Polymorphic MRPT object (e.g. the submap point cloud): class and content.
+mrpt::serialization::CSerializable::Ptr deserializzaMrptPtr(const std::string & blob)
+{
+  mrpt::io::CMemoryStream ms;
+  ms.assignMemoryNotOwn(blob.data(), blob.size());
+  auto arch = mrpt::serialization::archiveFrom(ms);
+  return arch.ReadObject();
+}
+
+void bboxScrivi(Scrittore & w, const std::optional<mrpt::math::TBoundingBoxf> & b)
+{
+  w.u8(b.has_value());
+  if (!b) return;
+  for (const auto * p : {&b->min, &b->max}) {
+    w.pod<float>(p->x);
+    w.pod<float>(p->y);
+    w.pod<float>(p->z);
+  }
+}
+
+std::optional<mrpt::math::TBoundingBoxf> bboxLeggi(Lettore & r)
+{
+  if (!r.u8()) return std::nullopt;
+  mrpt::math::TPoint3Df mn, mx;
+  for (auto * p : {&mn, &mx}) {
+    p->x = r.pod<float>();
+    p->y = r.pod<float>();
+    p->z = r.pod<float>();
+  }
+  return mrpt::math::TBoundingBoxf(mn, mx, mrpt::math::TBoundingBoxf::CTOR_FLAGS::AllowUnordered);
+}
+
+void covScrivi(Scrittore & w, const std::vector<mrpt::math::CMatrixFloat33> & v)
+{
+  w.u64(v.size());
+  for (const auto & m : v)
+    for (int i = 0; i < 3; i++)
+      for (int j = 0; j < 3; j++) w.pod<float>(m(i, j));
+}
+
+void covLeggi(Lettore & r, std::vector<mrpt::math::CMatrixFloat33> & v)
+{
+  v.clear();
+  const auto n = r.u64();
+  v.resize(n);
+  for (auto & m : v)
+    for (int i = 0; i < 3; i++)
+      for (int j = 0; j < 3; j++) m(i, j) = r.pod<float>();
+}
+
+// ICP search submap, with all its caches except the visualization-only ones
+// (cached_viz_, cachez_viz_covs_). The internal KD-trees of the point clouds
+// are not serializable: they are rebuilt from the same points at the first search.
+template <typename KF>
+void submapScrivi(Scrittore & w, const KF & kf)
+{
+  w.tempo(kf.timestamp);
+  w.u64(kf.*get(KfKCorr{}));
+  w.u64(kf.*get(KfMinCorr{}));
+  w.f64(kf.*get(KfMaxDist{}));
+  const auto & pc = kf.*get(KfPc{});
+  w.u8(static_cast<bool>(pc));
+  if (pc) w.stringa(serializzaMrpt(*pc));
+  w.posa(kf.*get(KfPose{}));
+  bboxScrivi(w, kf.*get(KfBBox{}));
+  const auto & dens = kf.*get(KfDensity{});
+  w.u8(dens.has_value());
+  w.pod<float>(dens.value_or(0.0f));
+  covScrivi(w, kf.*get(KfCovLocal{}));
+  covScrivi(w, kf.*get(KfCovGlobal{}));
+  const auto & pcg = kf.*get(KfPcGlobal{});
+  // 0: absent, 1: same cloud as pointcloud_, 2: own cloud
+  const uint8_t modo = !pcg ? 0 : (pcg == pc ? 1 : 2);
+  w.pod<uint8_t>(modo);
+  if (modo == 2) w.stringa(serializzaMrpt(*pcg));
+}
+
+mrpt::maps::CPointsMap::Ptr nuvolaLeggi(Lettore & r)
+{
+  auto o = deserializzaMrptPtr(r.stringa());
+  auto pc = std::dynamic_pointer_cast<mrpt::maps::CPointsMap>(o);
+  if (!pc) throw std::runtime_error("stato completo: nuvola del submap di classe inattesa");
+  return pc;
+}
+
+template <typename KF>
+void submapLeggi(Lettore & r, KF & kf)
+{
+  kf.timestamp = r.tempo();
+  kf.*get(KfKCorr{}) = static_cast<std::size_t>(r.u64());
+  kf.*get(KfMinCorr{}) = static_cast<std::size_t>(r.u64());
+  kf.*get(KfMaxDist{}) = r.f64();
+  mrpt::maps::CPointsMap::Ptr pc;
+  if (r.u8()) pc = nuvolaLeggi(r);
+  kf.*get(KfPc{}) = pc;
+  r.posa(kf.*get(KfPose{}));
+  kf.*get(KfBBox{}) = bboxLeggi(r);
+  const bool hasDens = r.u8();
+  const float dens = r.pod<float>();
+  kf.*get(KfDensity{}) = hasDens ? std::optional<float>(dens) : std::nullopt;
+  covLeggi(r, kf.*get(KfCovLocal{}));
+  covLeggi(r, kf.*get(KfCovGlobal{}));
+  const auto modo = r.pod<uint8_t>();
+  if (modo == 0) {
+    (kf.*get(KfPcGlobal{})).reset();
+  } else if (modo == 1) {
+    kf.*get(KfPcGlobal{}) = pc;
+  } else {
+    kf.*get(KfPcGlobal{}) = nuvolaLeggi(r);
+  }
+}
+
+// For the log: ICP selection and submap size of each keyframe map.
+std::string descriviCacheIcp(const mp2p_icp::metric_map_t & mm)
+{
+  std::ostringstream ss;
+  for (const auto & [nome, ly] : mm.layers) {
+    if (!ly || std::string(ly->GetRuntimeClass()->className) != "mola::KeyframePointCloudMap") {
+      continue;
+    }
+    const auto * m = static_cast<const KeyframePointCloudMap *>(ly.get());
+    auto lck = mrpt::lockHelper(*(m->*get(KfmMtx{})));
+    const auto & c = m->*get(KfmCached{});
+    ss << " [" << nome << ": icp_search_kfs=";
+    if (c.icp_search_kfs) {
+      ss << "(";
+      bool primo = true;
+      for (const auto id : *c.icp_search_kfs) {
+        ss << (primo ? "" : ",") << id;
+        primo = false;
+      }
+      ss << ")";
+    } else {
+      ss << "nessuna";
+    }
+    ss << " submap=";
+    if (c.icp_search_submap && c.icp_search_submap->pointcloud()) {
+      ss << c.icp_search_submap->pointcloud()->size() << " punti";
+    } else {
+      ss << (c.icp_search_submap ? "senza nuvola" : "assente");
+    }
+    ss << "]";
+  }
+  return ss.str();
+}
+
+template <typename T>
+void bufferCircolareScrivi(Scrittore & w, const mrpt::containers::circular_buffer<T> & b)
+{
+  w.u64(b.capacity());
+  w.u64(b.size());
+  for (std::size_t i = 0; i < b.size(); i++) w.pod(b.peek(i));
+}
+
+template <typename T>
+void bufferCircolareLeggi(Lettore & r, mrpt::containers::circular_buffer<T> & b)
+{
+  const auto cap = r.u64();
+  if (cap != b.capacity()) throw std::runtime_error("stato completo: capacita' di un buffer diversa");
+  const auto n = r.u64();
+  b.clear();
+  for (uint64_t i = 0; i < n; i++) b.push(r.pod<T>());
+}
+
+void vettori3Scrivi(Scrittore & w, const std::map<double, mrpt::math::TVector3D> & m)
+{
+  w.u64(m.size());
+  for (const auto & [t, v] : m) {
+    w.f64(t);
+    w.f64(v.x);
+    w.f64(v.y);
+    w.f64(v.z);
+  }
+}
+
+void vettori3Leggi(Lettore & r, std::map<double, mrpt::math::TVector3D> & m)
+{
+  m.clear();
+  const auto n = r.u64();
+  for (uint64_t i = 0; i < n; i++) {
+    const double t = r.f64();
+    mrpt::math::TVector3D v;
+    v.x = r.f64();
+    v.y = r.f64();
+    v.z = r.f64();
+    m.emplace(t, v);
+  }
+}
+
+// Estimator functions, looked up by name in its already loaded library:
+// the LO library does not link against the estimator library.
+using FnSalvaSes = int (*)(const void *, std::string *, std::string *);
+using FnCaricaSes = int (*)(void *, const std::string *, int, std::string *);
+
+void * simboloSes(const char * nome)
+{
+  if (void * h = dlopen("libmola_state_estimation_simple.so.2.4", RTLD_NOW | RTLD_NOLOAD); h) {
+    void * s = dlsym(h, nome);
+    dlclose(h);
+    if (s) return s;
+  }
+  return dlsym(RTLD_DEFAULT, nome);
+}
+
+void richiedi(bool cond, const char * cosa)
+{
+  if (!cond) {
+    throw std::runtime_error(std::string("stato completo: non gestito, ") + cosa);
+  }
+}
